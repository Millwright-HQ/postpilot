# ---------- local development (npm run dev) ----------
STORE=file                       # JSON file in ./data instead of DynamoDB; polling instead of EventBridge
DRY_RUN=true                     # nothing is really posted until this is "false"
ADMIN_PASSWORD=change-me         # the login password
AUTH_SECRET=                     # long random string (signs cookies); not needed with STORE=file
PUBLIC_BASE_URL=http://localhost:3000

# ---------- production (set these in Vercel; remove STORE) ----------
# PUBLIC_BASE_URL=https://postpilot.yourdomain.com
# MEDIA_BASE_URL=<MediaBaseUrl stack output>
# MEDIA_BUCKET=<MediaBucketName output>
# ACCOUNTS_TABLE / POSTS_TABLE / TARGETS_TABLE=<table name outputs>
# SCHEDULE_GROUP / SCHEDULER_ROLE_ARN / FUNCTION_ARN=<outputs>
# APP_AWS_REGION=us-east-1
# APP_AWS_ACCESS_KEY_ID=...        # from: aws iam create-access-key --user-name postpilot-vercel
# APP_AWS_SECRET_ACCESS_KEY=...

# ---------- platform apps (also store these in SSM under /postpilot/ so the Lambda can refresh tokens) ----------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YT_PRIVACY=private
TIKTOK_PRIVACY=SELF_ONLY
